  "drivers": {
    "_info": "Los .inf de la carpeta herramientas\\drivers (red, wifi, etc.) se instalan primero. Después se buscan drivers en Windows Update. Los instaladores de chipset/GPU que pongas en herramientas\\instaladores se ejecutan con los argumentos indicados.",
    "windows_update": true,
    "instaladores": [
      {"archivo": "AMD_Chipset*.exe",  "argumentos": "/S",                          "si_cpu": "AMD"},
      {"archivo": "NVIDIA*.exe",       "argumentos": "-s -noreboot -noeula",        "si_gpu": "NVIDIA"},
      {"archivo": "amd-software*.exe", "argumentos": "-INSTALL",                    "si_gpu": "AMD"}
    ]
